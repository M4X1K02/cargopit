# Maintainer: M4X1K02 <maxik.secure@tutanota.com>
_reponame=cargopit
pkgname=cargopit
_release_tag=0.4.0
pkgver=$_release_tag
pkgrel=1
pkgdesc="Device Manager for Racing Sims"
arch=('x86_64')
url="https://github.com/M4X1K02/cargopit"
license=('GPL3')
depends=(
        hidapi
	libserialport
	libxml2
	argtable
	libconfig
	libpulse
	libxdg-basedir
	libuv
)
makedepends=(
  git
  cmake
  rust
)

source=("cargopit::git+https://github.com/M4X1K02/cargopit.git#tag=$_release_tag")

sha256sums=(
  'SKIP'
)

package() {
  cd "$srcdir/$_reponame" || exit 1
  git submodule sync --recursive
  git submodule update --init --recursive
  mkdir -p build
  cd build
  cmake -Wno-dev -DUSE_PULSEAUDIO=yes ..
  make

  mkdir -p "${pkgdir}/usr/bin/"
  cp "$srcdir/$_reponame"/build/cargopit "${pkgdir}/usr/bin/cargopit"
  if [ -x "$srcdir/$_reponame"/build/tui/release/cargopit-tui ]; then
    cp "$srcdir/$_reponame"/build/tui/release/cargopit-tui "${pkgdir}/usr/bin/cargopit-tui"
  elif [ -x "$srcdir/$_reponame"/build/tui/debug/cargopit-tui ]; then
    cp "$srcdir/$_reponame"/build/tui/debug/cargopit-tui "${pkgdir}/usr/bin/cargopit-tui"
  fi
  install -D -m644 "$srcdir/$_reponame"/LICENSE.rst -t "${pkgdir}/usr/share/licenses/$_reponame"
}
