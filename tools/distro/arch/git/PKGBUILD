# Maintainer: M4X1K02 <maxik.secure@tutanota.com>
_reponame=cargopit
pkgname=cargopit-git
pkgver=0.4.0.r0
pkgrel=1
pkgdesc="Device Manager for Racing Sims"
arch=('x86_64')
url="https://github.com/M4X1K02/cargopit"
license=('GPL3')
depends=(
        hidapi
	libserialport
	libpulse
	lua54
	procps-ng
)
makedepends=(
  git
  cmake
  rust
  clang
  pkgconf
)
source=(
  cargopit::git+https://github.com/M4X1K02/cargopit
)
sha256sums=(
  'SKIP'
)

pkgver() {
  cd "$srcdir/$_reponame"
  git describe --long --tags | cut -d "-" -f 1-2 | tr "-" "r"
}

package() {
  cd "$srcdir/$_reponame" || exit 1
  git submodule sync --recursive
  git submodule update --init --recursive
  cmake -B build -DCMAKE_BUILD_TYPE=Release
  cmake --build build

  mkdir -p "${pkgdir}/usr/bin/"
  cp "$srcdir/$_reponame"/build/cargopit "${pkgdir}/usr/bin/$_reponame"
  cp "$srcdir/$_reponame"/build/cargopit-tui "${pkgdir}/usr/bin/cargopit-tui"
}
