# Maintainer: M4X1K02 <maxik.secure@tutanota.com>
_reponame=cargopit
pkgname=cargopit-git
pkgver=0.4.0.r0
pkgrel=1
pkgdesc="Device Manager for Racing Sims"
arch=('x86_64')
url="https://github.com/M4X1K02/cargopit"
license=('GPL3')
depends=(
        hidapi
	libserialport
	libxml2
	argtable
	libconfig
	libpulse
	libxdg-basedir
	libuv
)
makedepends=(
  git
  cmake
  rust
)
source=(
  cargopit::git+https://github.com/M4X1K02/cargopit
)
sha256sums=(
  'SKIP'
)

pkgver() {
  cd "$srcdir/$_reponame"
  git describe --long --tags | cut -d "-" -f 1-2 | tr "-" "r"
}

package() {
  cd "$srcdir/$_reponame" || exit 1
  git submodule sync --recursive
  git submodule update --init --recursive
  mkdir -p build
  cd build
  cmake -DUSE_PULSEAUDIO=yes ..
  make
  cd ..
  cargo build --release -p cargopit --manifest-path Cargo.toml

  mkdir -p "${pkgdir}/usr/bin/"
  cp "$srcdir/$_reponame"/target/release/$_reponame "${pkgdir}/usr/bin/$_reponame"
  cp "$srcdir/$_reponame"/build/cargopit-legacy "${pkgdir}/usr/bin/cargopit-legacy"
  if [ -x "$srcdir/$_reponame"/build/tui/release/cargopit-tui ]; then
    cp "$srcdir/$_reponame"/build/tui/release/cargopit-tui "${pkgdir}/usr/bin/cargopit-tui"
  elif [ -x "$srcdir/$_reponame"/build/tui/debug/cargopit-tui ]; then
    cp "$srcdir/$_reponame"/build/tui/debug/cargopit-tui "${pkgdir}/usr/bin/cargopit-tui"
  fi
}
