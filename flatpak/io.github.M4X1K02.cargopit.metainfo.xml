<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.M4X1K02.cargopit</id>
  <name>Cargopit</name>
  <summary>Device manager for racing sims</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Cargopit bridges telemetry from supported racing simulators to
      peripheral devices such as haptic shakers, LED strips, shift lights,
      and sim wind fans. Configure devices from the terminal UI
      (cargopit-tui) and drive them from the cargopit CLI.
    </p>
  </description>
  <launchable type="desktop-id">io.github.M4X1K02.cargopit.desktop</launchable>
    <provides>
    <binary>cargopit</binary>
    <binary>cargopit-tui</binary>
  </provides>
  <url type="homepage">https://spacefreak18.github.io/simapi/</url>
  <url type="vcs-browser">https://github.com/M4X1K02/cargopit</url>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.3.6" date="2026-08-21" />
  </releases>
</component>
